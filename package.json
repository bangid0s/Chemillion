{
  "name": "chemillion-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chemillion company profile website with Payload CMS admin dashboard",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "seed": "payload run scripts/seed.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "typecheck": "tsc --noEmit",
    "vercel-build": "payload migrate && npm run seed && next build --webpack"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node": "^22.23.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.92.1",
    "@payloadcms/db-sqlite": "^3.92.1",
    "@payloadcms/email-nodemailer": "^3.92.1",
    "@payloadcms/live-preview-react": "^3.92.1",
    "@payloadcms/next": "^3.92.1",
    "@payloadcms/plugin-seo": "^3.92.1",
    "@payloadcms/richtext-lexical": "^3.92.1",
    "@payloadcms/storage-vercel-blob": "^3.92.1",
    "@payloadcms/ui": "^3.92.1",
    "graphql": "^16.14.2",
    "next": "^16.4.3",
    "payload": "^3.92.1",
    "qs-esm": "^8.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  }
}
