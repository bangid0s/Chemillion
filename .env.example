# Copy to .env. Secrets stay in .env, which is never committed.

# Long random string used to sign admin sessions.
PAYLOAD_SECRET=change-me

# Local development: SQLite file. Production: a postgres:// URL (the PRD's recommended database).
DATABASE_URI=file:./data/chemillion.db

# Public URL of the site, used for canonical tags, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email. Inquiries are always saved to the dashboard; without SMTP the emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@chemillion.com
EMAIL_FROM_NAME=Chemillion

# Header your reverse proxy sets to the visitor's real IP, used for the form rate limit:
# cf-connecting-ip behind Cloudflare, x-real-ip for a typical nginx setup. Blank uses the last x-forwarded-for entry.
CLIENT_IP_HEADER=

# Cloudflare Turnstile. Leave blank to rely on the honeypot, time check and rate limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Blob storage for uploads. Vercel sets this when you connect a Blob store; leave blank locally to keep files in media/.
BLOB_READ_WRITE_TOKEN=
